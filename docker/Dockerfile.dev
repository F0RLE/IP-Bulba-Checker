FROM rust:1.94-bookworm

ENV DEBIAN_FRONTEND=noninteractive
ENV CARGO_TERM_COLOR=always

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    clang \
    cmake \
    git \
    perl \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

CMD ["bash"]
